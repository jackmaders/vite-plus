{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-12-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanstack-start-dev",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "./drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tanstack-start-images-dev",
      "preview_bucket_name": "tanstack-start-images-preview"
    }
  ],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanstack-start-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "./drizzle",
          "migrations_pattern": "drizzle/*/migration.sql"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "tanstack-start-images-preview"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:4173"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"]
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "set-your-production-database-name",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "./drizzle",
          "migrations_pattern": "drizzle/*/migration.sql"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "set-your-production-images-bucket-name"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://set-your-production-domain.invalid"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"]
      }
    }
  }
}
